<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Only the keys Xcode cannot generate from build settings live here; everything else
	  (display name, orientations, Face ID usage string, scene manifest) is an INFOPLIST_KEY_*
	  in the target's build settings and is merged into this file at build time.
	-->

	<!--
	  Long-press the Home Screen icon and land on the thing you opened the app to do, rather
	  than on Home with three taps still to go. These are the three jobs of the monthly sit-down.
	  The types are matched in QuickActionRouter.
	-->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.ryanwalsh.FinSight.balances</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Update balances</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Type in what each account says</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeUpdate</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.ryanwalsh.FinSight.spend</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Add spending</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>What the month cost</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeCompose</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.ryanwalsh.FinSight.payslip</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Add payslip</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Drop the PDF in</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeAdd</string>
		</dict>
	</array>

	<!--
	  A launch screen painted the dashboard's own background, so the moment before first paint
	  is the same colour as the app rather than a white flash.
	-->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<!--
	  Export compliance, answered once here rather than at every upload. The only cryptography in
	  FinSight is SHA-256, used to hash the app-lock PIN, and it comes from the operating system's
	  own WebCrypto — Face ID goes through LocalAuthentication, which is a check rather than a
	  cipher. Standard OS-provided cryptography is exempt. Declaring it false stops App Store
	  Connect stopping to ask, and stops anyone answering it wrong in a hurry.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!--
	  There is deliberately no UIFileSharingEnabled here. It used to be set, which put a FinSight
	  folder in the Files app — and nothing is ever written to Documents, since a backup goes to
	  the temporary directory and straight out through the share sheet. All it did was promise a
	  folder of your data that turns out to be empty.
	-->
</dict>
</plist>
